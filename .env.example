# Set ONE of these. Whichever key is present is the one used.
# Google has a real free tier and needs no card — start here.
GEMINI_API_KEY=

# Claude. Better at the judgement call, pay as you go.
ANTHROPIC_API_KEY=

# Only needed if both keys are set: which one wins. gemini | anthropic
TW_PROVIDER=

# Optional. Defaults to gemini-2.5-flash or claude-haiku-5-5.
TW_MODEL=

# Recommended once there is traffic. Without these the endpoint falls back
# to a per-instance counter, which stops casual hammering but is not a real
# limit. Free tier at upstash.com, or one click from Vercel's Storage tab.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional tuning.
TW_PER_VISITOR_PER_DAY=6
TW_GLOBAL_PER_DAY=600
