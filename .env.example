# Required. The key TangleWire uses for visitors who have not brought their own.
ANTHROPIC_API_KEY=sk-ant-...

# Strongly recommended. Without these two the endpoint counts nothing and
# anyone can spend your credit without limit. Free tier at upstash.com.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional tuning.
TW_MODEL=claude-haiku-5-5
TW_PER_VISITOR_PER_DAY=6
TW_GLOBAL_PER_DAY=600
